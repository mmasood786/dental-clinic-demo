# Public site URL used for canonical links, sitemap, Open Graph tags and email links
NEXT_PUBLIC_SITE_URL=https://www.yourclinic.com

# Neon Postgres connection string for the contact-events analytics table (optional)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend API key for contact form emails (optional)
RESEND_API_KEY=

# Verified sender address for outgoing contact form email
EMAIL_FROM="Clinic <bookings@yourclinic.com>"

# Google Places API (New) key, used server-side to show live Google reviews and ratings
GOOGLE_PLACES_API_KEY=

# GA4 Measurement ID (G-XXXXXXX); analytics loads only after the visitor accepts cookies
NEXT_PUBLIC_GA_ID=

# Password for the protected /admin/analytics dashboard (HTTP Basic auth, any username)
ADMIN_PASSWORD=
